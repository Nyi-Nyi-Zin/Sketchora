<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Sketchora.ico</ApplicationIcon>
    <AssemblyName>Sketchora</AssemblyName>
    <RootNamespace>Sketchora.App</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.4.0-preview.1</Version>
    <Description>Screen annotation and whiteboard tools for teaching.</Description>
    <!-- WPF owns DPI awareness through the manifest. WinForms is used only for
         the tray and screen capture, not for application startup/windows. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Sketchora.ico" />
    <Resource Include="Assets/Sketchora.png" />
    <ProjectReference Include="../Sketchora.Core/Sketchora.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
