      <Setter Property="Foreground" Value="#F1F5F9"/>
      <Setter Property="BorderBrush" Value="#40536C"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Background" Value="#2B3A50"/>
