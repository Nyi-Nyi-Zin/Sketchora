<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Sketchora.App.ViewModels" xmlns:icons="clr-namespace:Sketchora.App.Controls" xmlns:converters="clr-namespace:Sketchora.App.Converters" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" x:Class="Sketchora.App.Views.ToolbarWindow" Title="Sketchora" Icon="/Sketchora;component/Assets/Sketchora.ico" Width="60" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="12" Foreground="#E5EDF9">
