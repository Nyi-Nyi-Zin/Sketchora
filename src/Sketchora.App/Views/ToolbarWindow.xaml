                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Background="{Binding}" Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding}" MinHeight="26" Height="26" Padding="0" BorderBrush="#687D99">
                    <Button.ToolTip>
                      <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="NextColor|Use colour {colour}">
