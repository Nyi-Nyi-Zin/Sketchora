<Window x:Class="Sketchora.App.Views.ToolbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Sketchora.App.ViewModels"
    xmlns:converters="clr-namespace:Sketchora.App.Converters"
    Title="Sketchora" Width="344" SizeToContent="Height" WindowStyle="None"
    ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
    Topmost="True" ShowInTaskbar="False" UseLayoutRounding="True"
    FontFamily="Segoe UI" FontSize="13" Foreground="#EEF2FF">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <converters:EqualsConverter x:Key="Equals" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EEF2FF" />
      <Setter Property="Background" Value="#252B3D" />
      <Setter Property="BorderBrush" Value="#3A435B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
              Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#A5B4FC" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="White" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Tool" TargetType="RadioButton">
      <Setter Property="Margin" Value="3" />
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#CED5EA" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="#252B3D" CornerRadius="8" BorderBrush="#3A435B" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#4F46E5" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#A5B4FC" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#A5B4FC" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="White" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#CED5EA" />
      <Setter Property="Margin" Value="4,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <Border Background="#171B29" BorderBrush="#3A435B" BorderThickness="1" CornerRadius="16" Padding="12">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderDrag" Margin="3,2,3,10">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#4F46E5" CornerRadius="7" Padding="7,3" Margin="0,0,9,0"><TextBlock Text="S" FontWeight="Bold" /></Border>
          <TextBlock Text="Sketchora" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Content="− / +" Command="{Binding CollapseCommand}"
            AutomationProperties.Name="Collapse or expand toolbar" ToolTip="Collapse or expand toolbar" MinHeight="32" Padding="7,3" />
      </Grid>
      <Grid Margin="3,0,3,6">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button Content="{Binding ModeActionLabel}" Command="{Binding ToggleDrawCommand}"
            Background="#4F46E5" BorderBrush="#818CF8" FontWeight="SemiBold"
            AutomationProperties.Name="Toggle drawing and desktop interaction" ToolTip="{Binding ShortcutHint}" />
        <TextBlock Grid.Column="1" Text="{Binding ModeLabel}" Foreground="#A5B4FC" FontSize="11"
            FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,3,0" />
      </Grid>
      <TextBlock Text="{Binding LessonLabel}" TextTrimming="CharacterEllipsis" Foreground="#A7B1C9" FontSize="11" Margin="5,0,5,6" ToolTip="{Binding LessonLabel}" />
      <TextBlock Text="{Binding Tool, StringFormat='Tool: {0}'}" Foreground="#A5B4FC" FontSize="11" Margin="5,0,5,6" />
      <UniformGrid Rows="1" Columns="4">
        <Button Content="Pen" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:DrawingTool.Pen}" />
        <Button Content="Laser" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:DrawingTool.Fading}" />
        <Button Content="Board" Command="{Binding CycleBoardCommand}" />
        <Button Content="Save" Command="{Binding SaveLessonCommand}" />
      </UniformGrid>
      <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}">
        <UniformGrid Rows="1" Columns="4">
          <Button Content="New" Command="{Binding NewLessonCommand}" ToolTip="New lesson · Ctrl + N when toolbar is focused" />
          <Button Content="Open" Command="{Binding OpenLessonCommand}" ToolTip="Open .sketchora lesson" />
          <Button Content="Save" Command="{Binding SaveLessonCommand}" ToolTip="Save editable lesson" />
          <Button Content="Save as" Command="{Binding SaveLessonAsCommand}" />
        </UniformGrid>
        <TextBlock Text="DRAWING TOOLS" Foreground="#8793B2" FontSize="10" FontWeight="Bold" Margin="5,9,0,4" />
        <WrapPanel>
          <RadioButton Style="{StaticResource Tool}" Content="Pen" GroupName="Tools" Command="{Binding SelectToolCommand}"
              CommandParameter="{x:Static vm:DrawingTool.Pen}" IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:DrawingTool.Pen}}" ToolTip="Freehand pen" />
          <RadioButton Style="{StaticResource Tool}" Content="Highlight" GroupName="Tools" Command="{Binding SelectToolCommand}"
              CommandParameter="{x:Static vm:DrawingTool.Highlighter}" IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:DrawingTool.Highlighter}}" ToolTip="Translucent highlighter" />
          <RadioButton Style="{StaticResource Tool}" Content="Eraser" GroupName="Tools" Command="{Binding SelectToolCommand}"
              CommandParameter="{x:Static vm:DrawingTool.Eraser}" IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:DrawingTool.Eraser}}" ToolTip="Erase a whole stroke or shape" />
          <RadioButton Style="{StaticResource Tool}" Content="Line" GroupName="Tools" Command="{Binding SelectToolCommand}"
              CommandParameter="{x:Static vm:DrawingTool.Line}" IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:DrawingTool.Line}}" />
          <RadioButton Style="{StaticResource Tool}" Content="Arrow" GroupName="Tools" Command="{Binding SelectToolCommand}"
              CommandParameter="{x:Static vm:DrawingTool.Arrow}" IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:DrawingTool.Arrow}}" />
          <RadioButton Style="{StaticResource Tool}" Content="Box" GroupName="Tools" Command="{Binding SelectToolCommand}"
              CommandParameter="{x:Static vm:DrawingTool.Rectangle}" IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:DrawingTool.Rectangle}}" />
          <RadioButton Style="{StaticResource Tool}" Content="Oval" GroupName="Tools" Command="{Binding SelectToolCommand}"
              CommandParameter="{x:Static vm:DrawingTool.Ellipse}" IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:DrawingTool.Ellipse}}" />
          <RadioButton Style="{StaticResource Tool}" Content="Text" GroupName="Tools" Command="{Binding SelectToolCommand}"
              CommandParameter="{x:Static vm:DrawingTool.Text}" IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:DrawingTool.Text}}" ToolTip="Click canvas to add text; drag labels to move; double-click to edit" />
          <RadioButton Style="{StaticResource Tool}" Content="Fading" GroupName="Tools" Command="{Binding SelectToolCommand}"
              CommandParameter="{x:Static vm:DrawingTool.Fading}" IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:DrawingTool.Fading}}" ToolTip="Temporary laser strokes; excluded from lessons and PNG exports" />
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Margin="5,6">
          <TextBlock Text="Fade after" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding FadeDurations}" SelectedItem="{Binding FadeSeconds}" Width="52" Foreground="#171B29" AutomationProperties.Name="Temporary ink lifetime in seconds" />
          <TextBlock Text=" seconds" VerticalAlignment="Center" />
          <Button Content="Clear laser" Command="{Binding ClearTemporaryCommand}" Padding="6,4" MinHeight="32" />
        </StackPanel>
        <TextBlock Text="COLOR &amp; WIDTH" Foreground="#8793B2" FontSize="10" FontWeight="Bold" Margin="5,13,0,4" />
        <ItemsControl ItemsSource="{Binding Colors}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Background="{Binding}" Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}" ToolTip="{Binding}" AutomationProperties.Name="{Binding}" Padding="0" MinHeight="32" />
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Custom colour…" Command="{Binding CustomColorCommand}" />
        <Grid Margin="5,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
          <Border Width="18" Height="18" Background="{Binding Color}" CornerRadius="9" BorderBrush="#8793B2" BorderThickness="1" />
          <Slider Grid.Column="1" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
              Value="{Binding Thickness}" VerticalAlignment="Center" AutomationProperties.Name="Ink width" />
          <TextBlock Grid.Column="2" Text="{Binding Thickness, StringFormat={}{0:0} px}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding PageLabel}" TextWrapping="Wrap" Foreground="#A7B1C9" FontSize="11" Margin="5,8,5,4" />
        <UniformGrid Rows="1" Columns="3">
          <Button Content="Previous" Command="{Binding PreviousPageCommand}" />
          <Button Content="Next" Command="{Binding NextPageCommand}" />
          <Button Content="Add page" Command="{Binding AddPageCommand}" />
        </UniformGrid>
        <UniformGrid Rows="1" Columns="4">
          <Button Content="Rename" Command="{Binding RenamePageCommand}" Padding="5,8" />
          <Button Content="Copy" Command="{Binding DuplicatePageCommand}" />
          <Button Content="Delete" Command="{Binding DeletePageCommand}" />
          <Button Content="Restore" Command="{Binding RestorePageCommand}" ToolTip="Restore the last deleted board" />
        </UniformGrid>
        <Button Content="{Binding BoardLabel}" Command="{Binding CycleBoardCommand}" ToolTip="Switch between desktop and the selected board page" />
        <Button Content="White / black page background" Command="{Binding ToggleBackgroundCommand}" />
        <WrapPanel>
          <CheckBox Content="Show ink" IsChecked="{Binding ShowInk}" />
          <CheckBox Content="Pointer halo" IsChecked="{Binding HaloEnabled}" />
          <CheckBox Content="Touch drawing" IsChecked="{Binding TouchEnabled}" />
          <CheckBox Content="Pen pressure" IsChecked="{Binding PressureEnabled}" />
          <CheckBox Content="Ignore touch near pen" IsChecked="{Binding PalmRejection}" />
        </WrapPanel>
        <UniformGrid Rows="1" Columns="3">
          <Button Content="Undo" Command="{Binding UndoCommand}" ToolTip="Ctrl + Z when toolbar is focused" />
          <Button Content="Redo" Command="{Binding RedoCommand}" ToolTip="Ctrl + Y when toolbar is focused" />
          <Button Content="Clear" Command="{Binding ClearCommand}" ToolTip="Clear active canvas; undo is available" />
        </UniformGrid>
        <Button Content="Save PNG" Command="{Binding ExportCommand}" ToolTip="Save all displays with annotations; toolbar is omitted" />
        <UniformGrid Columns="2">
          <Button Content="Copy screenshot" Command="{Binding CopyScreenshotCommand}" />
          <Button Content="Capture region…" Command="{Binding RegionScreenshotCommand}" />
        </UniformGrid>
        <Button Content="Ghost Mode" Command="{Binding GhostCommand}" ToolTip="Hide toolbar and keep drawing. Ctrl+Alt+G restores it by default; the tray always recovers it." />
        <Separator Background="#3A435B" Margin="4,10" />
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#A7B1C9" FontSize="11" Margin="5,0,5,8" />
        <TextBlock Text="{Binding ShortcutHint}" Foreground="#8793B2" FontSize="11" Margin="5,0,5,8" />
        <Button Content="Shortcut settings" Command="{Binding SettingsCommand}" />
        <UniformGrid Rows="1" Columns="2">
          <Button Content="Hide all" Command="{Binding HideCommand}" />
          <Button Content="Quit" Command="{Binding ExitCommand}" />
        </UniformGrid>
      </StackPanel>
    </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
