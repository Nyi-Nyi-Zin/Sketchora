      <Popup x:Name="ColourPopup" PlacementTarget="{Binding ElementName=ColourMenuButton}" Placement="Right" IsOpen="{Binding IsChecked, ElementName=ColourMenuButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <Border Style="{StaticResource Flyout}">
          <StackPanel Width="244">
