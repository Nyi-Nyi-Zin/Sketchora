              </Button>
              <Button x:Name="RectangleChoice" Tag="Tool.Rectangle" AutomationProperties.Name="Rectangle" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:DrawingTool.Rectangle}" Click="OnToolChosen">
