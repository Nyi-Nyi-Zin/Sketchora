            <Button x:Name="RegionButton" Tag="RegionScreenshot" AutomationProperties.Name="Capture region" Command="{Binding RegionScreenshotCommand}" Click="OnCaptureChosen">
              <Button.ToolTip>
                <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="RegionScreenshot|Capture region">
