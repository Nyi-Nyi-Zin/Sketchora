                  <icons:GlyphIcon Kind="Text" Width="20" Height="20"/>
                  <TextBlock Text="Text" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="FadingChoice" Tag="Tool.Fading" AutomationProperties.Name="Fading ink" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:DrawingTool.Fading}" Click="OnToolChosen">
