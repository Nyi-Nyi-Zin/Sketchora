                </StackPanel>
              </Button>
              <Button x:Name="SaveAsButton" Tag="SaveLessonAs" AutomationProperties.Name="Save as" Command="{Binding SaveLessonAsCommand}">
                <Button.ToolTip>
                  <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="SaveLessonAs|Save as|Ctrl + Shift + S">
                    <Binding/>
                    <Binding Path="ShortcutRevision"/>
                  </MultiBinding>
                </Button.ToolTip>
                <TextBlock Text="Save as"/>
              </Button>
            </UniformGrid>
            <TextBlock Text="BOARD PAGES" Style="{StaticResource Section}"/>
            <TextBlock Text="{Binding PageLabel}" Foreground="#B4C5DB" TextWrapping="Wrap" Margin="3,2,3,6"/>
            <UniformGrid Columns="3">
              <Button x:Name="PreviousPageButton" Tag="PreviousPage" AutomationProperties.Name="Previous" Command="{Binding PreviousPageCommand}">
                <Button.ToolTip>
                  <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="PreviousPage|Previous">
                    <Binding/>
                    <Binding Path="ShortcutRevision"/>
                  </MultiBinding>
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                  <icons:GlyphIcon Kind="Previous" Width="20" Height="20"/>
                </StackPanel>
              </Button>
              <Button x:Name="NextPageButton" Tag="NextPage" AutomationProperties.Name="Next" Command="{Binding NextPageCommand}">
                <Button.ToolTip>
                  <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="NextPage|Next">
                    <Binding/>
                    <Binding Path="ShortcutRevision"/>
                  </MultiBinding>
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                  <icons:GlyphIcon Kind="Next" Width="20" Height="20"/>
                </StackPanel>
              </Button>
              <Button x:Name="AddPageButton" Tag="AddPage" AutomationProperties.Name="Add" Command="{Binding AddPageCommand}">
                <Button.ToolTip>
                  <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="AddPage|Add">
                    <Binding/>
                    <Binding Path="ShortcutRevision"/>
                  </MultiBinding>
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                  <icons:GlyphIcon Kind="New" Width="20" Height="20"/>
                  <TextBlock Text="Add" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </UniformGrid>
            <UniformGrid Columns="2">
              <Button x:Name="RenamePageButton" Tag="RenamePage" AutomationProperties.Name="Rename" Command="{Binding RenamePageCommand}">
                <Button.ToolTip>
                  <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="RenamePage|Rename">
                    <Binding/>
                    <Binding Path="ShortcutRevision"/>
                  </MultiBinding>
                </Button.ToolTip>
                <TextBlock Text="Rename"/>
              </Button>
              <Button x:Name="DuplicatePageButton" Tag="DuplicatePage" AutomationProperties.Name="Duplicate" Command="{Binding DuplicatePageCommand}">
                <Button.ToolTip>
                  <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="DuplicatePage|Duplicate">
                    <Binding/>
                    <Binding Path="ShortcutRevision"/>
                  </MultiBinding>
                </Button.ToolTip>
                <TextBlock Text="Duplicate"/>
              </Button>
              <Button x:Name="DeletePageButton" Tag="DeletePage" AutomationProperties.Name="Delete page" Command="{Binding DeletePageCommand}">
                <Button.ToolTip>
                  <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="DeletePage|Delete page">
                    <Binding/>
                    <Binding Path="ShortcutRevision"/>
                  </MultiBinding>
                </Button.ToolTip>
                <TextBlock Text="Delete page"/>
              </Button>
              <Button x:Name="RestorePageButton" Tag="RestorePage" AutomationProperties.Name="Restore" Command="{Binding RestorePageCommand}">
                <Button.ToolTip>
                  <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="RestorePage|Restore">
                    <Binding/>
                    <Binding Path="ShortcutRevision"/>
                  </MultiBinding>
                </Button.ToolTip>
                <TextBlock Text="Restore"/>
              </Button>
            </UniformGrid>
            <Button x:Name="BackgroundButton" Tag="ToggleBackground" AutomationProperties.Name="White / black page" Command="{Binding ToggleBackgroundCommand}">
              <Button.ToolTip>
                <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="ToggleBackground|White / black page">
                  <Binding/>
                  <Binding Path="ShortcutRevision"/>
                </MultiBinding>
              </Button.ToolTip>
              <TextBlock Text="White / black page"/>
            </Button>
            <TextBlock Text="INPUT &amp; POINTER" Style="{StaticResource Section}"/>
            <CheckBox Content="Pointer halo" IsChecked="{Binding HaloEnabled}">
              <CheckBox.ToolTip>
                <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="ToggleHalo|Pointer halo">
                  <Binding/>
                  <Binding Path="ShortcutRevision"/>
                </MultiBinding>
              </CheckBox.ToolTip>
            </CheckBox>
            <CheckBox Content="Touch drawing" IsChecked="{Binding TouchEnabled}">
              <CheckBox.ToolTip>
                <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="ToggleTouch|Touch drawing">
                  <Binding/>
                  <Binding Path="ShortcutRevision"/>
                </MultiBinding>
              </CheckBox.ToolTip>
            </CheckBox>
            <CheckBox Content="Pen pressure" IsChecked="{Binding PressureEnabled}">
              <CheckBox.ToolTip>
                <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="TogglePressure|Pen pressure">
                  <Binding/>
                  <Binding Path="ShortcutRevision"/>
                </MultiBinding>
              </CheckBox.ToolTip>
            </CheckBox>
            <CheckBox Content="Ignore touch near pen" IsChecked="{Binding PalmRejection}">
              <CheckBox.ToolTip>
                <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="TogglePalm|Ignore touch near pen">
                  <Binding/>
                  <Binding Path="ShortcutRevision"/>
                </MultiBinding>
              </CheckBox.ToolTip>
            </CheckBox>
            <TextBlock Text="FADING INK" Style="{StaticResource Section}"/>
            <StackPanel Orientation="Horizontal" Margin="3,2">
              <TextBlock Text="Fade after" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox ItemsSource="{Binding FadeDurations}" SelectedItem="{Binding FadeSeconds}" Width="48" Foreground="#172235" AutomationProperties.Name="Fading ink lifetime in seconds" ToolTip="Fading ink lifetime in seconds"/>
              <TextBlock Text=" seconds" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="ClearLaserButton" Tag="ClearTemporary" AutomationProperties.Name="Clear fading ink" Command="{Binding ClearTemporaryCommand}">
              <Button.ToolTip>
                <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="ClearTemporary|Clear fading ink">
                  <Binding/>
                  <Binding Path="ShortcutRevision"/>
                </MultiBinding>
              </Button.ToolTip>
              <TextBlock Text="Clear fading ink"/>
            </Button>
            <Separator/>
            <Button x:Name="GhostButton" Tag="Ghost" AutomationProperties.Name="Ghost Mode" Command="{Binding GhostCommand}">
              <Button.ToolTip>
                <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="Ghost|Ghost Mode">
                  <Binding/>
                  <Binding Path="ShortcutRevision"/>
                </MultiBinding>
              </Button.ToolTip>
              <StackPanel Orientation="Horizontal">
                <icons:GlyphIcon Kind="Ghost" Width="20" Height="20"/>
                <TextBlock Text="Ghost Mode" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="SettingsButton" Tag="Settings" AutomationProperties.Name="Shortcut settings" Command="{Binding SettingsCommand}">
              <Button.ToolTip>
                <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="Settings|Shortcut settings">
                  <Binding/>
                  <Binding Path="ShortcutRevision"/>
                </MultiBinding>
              </Button.ToolTip>
              <StackPanel Orientation="Horizontal">
                <icons:GlyphIcon Kind="Settings" Width="20" Height="20"/>
                <TextBlock Text="Shortcut settings" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#8195AF" FontSize="11" Margin="3,9,3,6"/>
            <UniformGrid Columns="2">
              <Button x:Name="HideButton" Tag="Hide" AutomationProperties.Name="Hide all" Command="{Binding HideCommand}">
                <Button.ToolTip>
                  <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="Hide|Hide all">
                    <Binding/>
                    <Binding Path="ShortcutRevision"/>
                  </MultiBinding>
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                  <icons:GlyphIcon Kind="Hide" Width="20" Height="20"/>
                  <TextBlock Text="Hide all" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="QuitButton" Tag="Exit" AutomationProperties.Name="Quit" Command="{Binding ExitCommand}">
                <Button.ToolTip>
                  <MultiBinding Converter="{StaticResource ShortcutTip}" ConverterParameter="Exit|Quit">
                    <Binding/>
                    <Binding Path="ShortcutRevision"/>
                  </MultiBinding>
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                  <icons:GlyphIcon Kind="Quit" Width="20" Height="20"/>
                  <TextBlock Text="Quit" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Border>
</Window>
